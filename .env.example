# ============================================================
# Celia Repo Agent - environment configuration
# Copy this file to `.env` and fill in your real credentials.
# Never commit the real `.env` file (it is git-ignored).
# ============================================================

# GitHub Personal Access Token (classic) with the `repo` scope.
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Google Gemini API key.
# Create one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Your GitHub username (in CI this is set automatically to the repo owner).
GITHUB_USERNAME=your_github_username

# Optional: Gemini model used for generating fixes.
GEMINI_MODEL=gemini-2.5-flash

# Optional: set to `true` to audit repositories without creating
# any branches, commits, pull requests or comments (safe preview).
DRY_RUN=false
